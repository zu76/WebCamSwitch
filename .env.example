# Copy this file to ".env" and fill in your values, OR export these as
# real environment variables in your shell before running CamSwitch_obs.py.
#
# The .env file is gitignored so secrets are never committed.

# Required: OBS WebSocket password (Tools -> WebSocket Server Settings in OBS).
OBS_WS_PASSWORD=change_me

# Optional overrides (defaults shown).
# OBS_WS_HOST=localhost
# OBS_WS_PORT=4455
