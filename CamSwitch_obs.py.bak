import time
import math
import cv2
import mediapipe as mp
import base64
import numpy as np
from obswebsocket import obsws, requests

# =========================
# CONFIGURAZIONE UTENTE
# =========================

CAMERA_INDEX_A = 0
CAMERA_INDEX_B = 1  # May need adjustment if second camera not available

SCENE_A = "CAM_A"
SCENE_B = "CAM_B"

# Nomi delle sorgenti webcam in OBS (usati per fallback screenshot)
# Se None, proverà ad auto-rilevare cercando sorgenti di tipo "dshow_input" o "av_capture_input"
OBS_SOURCE_A = "Video Capture Device"  # Sorgente nella scena CAM_A
OBS_SOURCE_B = "Video Capture Device 2"  # Sorgente nella scena CAM_B

OBS_HOST = "localhost"
OBS_PORT = 4455
OBS_PASSWORD = "fbUKojx3JWxxxUW9"

# Modalità di cattura: "auto", "videocapture", "obs_screenshot"
CAPTURE_MODE = "auto"  # auto proverà videocapture prima, poi fallback a obs_screenshot

# Parametri logica
ANALYSIS_WIDTH = 640
LOOP_SLEEP = 0.15              # ~6-7 cicli al secondo
SWITCH_THRESHOLD = 0.01        # vantaggio minimo richiesto
SWITCH_PERSISTENCE = 0.2       # secondi per confermare lo switch
SWITCH_COOLDOWN = 1.0          # secondi minimi tra switch
NO_FACE_HOLD_SECONDS = 2.0     # se nessuna camera vede il volto, tieni l'ultima
SMOOTHING_ALPHA = 0.35         # media esponenziale score

# Pesi score
W_FACE_AREA = 0.60
W_CENTERING = 0.30
W_CONFIDENCE = 0.10

# =========================
# MEDIAPIPE
# =========================

from mediapipe import tasks

# Download face detection model if needed
import os
MODEL_PATH = os.path.join(os.path.dirname(__file__), "detector.tflite")
if not os.path.exists(MODEL_PATH):
    import urllib.request
    MODEL_URL = "https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite"
    print(f"Downloading face detection model to {MODEL_PATH}...")
    urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)
    print("Model downloaded.")

# =========================
# UTILS
# =========================

def resize_keep_ratio(frame, width):
    """Ridimensiona il frame mantenendo il ratio, con controlli di validità"""
    if frame is None or frame.size == 0:
        return None
    
    h, w = frame.shape[:2]
    if w == width:
        # Assicura che sia contiguo anche se non viene ridimensionato
        return np.ascontiguousarray(frame)
    
    if w <= 0 or h <= 0:
        return None
    
    new_h = int(h * (width / w))
    if new_h <= 0:
        return None
    
    resized = cv2.resize(frame, (width, new_h))
    return np.ascontiguousarray(resized)

def clamp(x, min_val=0.0, max_val=1.0):
    return max(min_val, min(max_val, x))

def compute_center_score(bbox_center_x, bbox_center_y, frame_w, frame_h):
    cx = frame_w / 2.0
    cy = frame_h / 2.0
    dx = abs(bbox_center_x - cx) / cx
    dy = abs(bbox_center_y - cy) / cy
    dist = math.sqrt(dx * dx + dy * dy)
    score = 1.0 - clamp(dist, 0.0, 1.0)
    return score

def analyze_frame(frame, detector):
    """
    Restituisce:
    {
        "face_found": bool,
        "score": float,
        "debug": {...}
    }
    """
    try:
        # Validazione frame
        if frame is None or frame.size == 0:
            return {
                "face_found": False,
                "score": 0.0,
                "debug": {
                    "face_area_norm": 0.0,
                    "center_score": 0.0,
                    "confidence": 0.0
                }
            }
        
        frame = resize_keep_ratio(frame, ANALYSIS_WIDTH)
        if frame is None:
            return {
                "face_found": False,
                "score": 0.0,
                "debug": {
                    "face_area_norm": 0.0,
                    "center_score": 0.0,
                    "confidence": 0.0
                }
            }
        
        h, w = frame.shape[:2]

        # Forza una copia completa del frame prima di processarlo
        frame_copy = frame.copy()
        rgb = cv2.cvtColor(frame_copy, cv2.COLOR_BGR2RGB)
        # Assicurati che l'array sia contiguo in memoria per evitare errori con MediaPipe
        rgb = np.ascontiguousarray(rgb)
        
        # Verifica che i dati siano validi prima di passarli a MediaPipe
        if not rgb.flags['C_CONTIGUOUS'] or rgb.dtype != np.uint8:
            rgb = np.ascontiguousarray(rgb, dtype=np.uint8)
        
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
        results = detector.detect(mp_image)
    except Exception as e:
        print(f"⚠ Errore in analyze_frame: {e}")
        return {
            "face_found": False,
            "score": 0.0,
            "debug": {
                "face_area_norm": 0.0,
                "center_score": 0.0,
                "confidence": 0.0
            }
        }

    if not results.detections:
        return {
            "face_found": False,
            "score": 0.0,
            "debug": {
                "face_area_norm": 0.0,
                "center_score": 0.0,
                "confidence": 0.0
            }
        }

    # Se ci sono più volti, prendo quello con score più alto
    best_score = -1.0
    best_debug = None

    for det in results.detections:
        score_conf = det.categories[0].score if det.categories else 0.0
        bbox = det.bounding_box

        x = bbox.origin_x
        y = bbox.origin_y
        bw = bbox.width
        bh = bbox.height

        if bw <= 0 or bh <= 0:
            continue

        face_area_norm = clamp((bw * bh) / float(w * h))
        center_x = x + bw / 2.0
        center_y = y + bh / 2.0
        center_score = compute_center_score(center_x, center_y, w, h)

        total_score = (
            W_FACE_AREA * face_area_norm +
            W_CENTERING * center_score +
            W_CONFIDENCE * score_conf
        )

        if total_score > best_score:
            best_score = total_score
            best_debug = {
                "face_area_norm": face_area_norm,
                "center_score": center_score,
                "confidence": score_conf
            }

    if best_score < 0:
        return {
            "face_found": False,
            "score": 0.0,
            "debug": {
                "face_area_norm": 0.0,
                "center_score": 0.0,
                "confidence": 0.0
            }
        }

    return {
        "face_found": True,
        "score": best_score,
        "debug": best_debug
    }

def smooth_score(prev_score, new_score, alpha=SMOOTHING_ALPHA):
    if prev_score is None:
        return new_score
    return alpha * new_score + (1 - alpha) * prev_score

def set_obs_scene(client, scene_name):
    client.call(requests.SetCurrentProgramScene(sceneName=scene_name))

def get_obs_scene(client):
    resp = client.call(requests.GetCurrentProgramScene())
    return resp.getCurrentProgramSceneName()

def get_obs_sources(client):
    """Ottiene la lista di tutte le sorgenti disponibili in OBS"""
    try:
        resp = client.call(requests.GetSourcesList())
        return resp.getSources()
    except Exception as e:
        print(f"Errore nel recuperare sorgenti OBS: {e}")
        return []

def find_camera_source(client, camera_index, preferred_name=None):
    """Trova il nome della sorgente camera in OBS per un dato indice"""
    if preferred_name:
        return preferred_name
    
    sources = get_obs_sources(client)
    camera_sources = []
    
    for source in sources:
        source_kind = source.get('typeId', '')
        # Cerca sorgenti di tipo webcam (dshow_input su Windows, av_capture_input su Mac)
        if 'dshow_input' in source_kind or 'av_capture_input' in source_kind or 'video_capture' in source_kind:
            camera_sources.append(source.get('sourceName', ''))
    
    # Se troviamo sorgenti, restituiamo quella corrispondente all'indice
    if camera_sources:
        if camera_index < len(camera_sources):
            return camera_sources[camera_index]
        elif camera_sources:
            # Fallback alla prima sorgente trovata
            return camera_sources[0]
    
    return None

def capture_obs_screenshot(client, source_name, width=1280, height=720):
    """Cattura uno screenshot di una sorgente OBS e restituisce un frame OpenCV"""
    try:
        # Usa GetSourceScreenshot per catturare l'immagine
        resp = client.call(requests.GetSourceScreenshot(
            sourceName=source_name,
            imageFormat="jpg",
            imageWidth=width,
            imageHeight=height
        ))
        
        # La risposta contiene l'immagine in formato base64
        img_data = resp.getImageData()
        if not img_data:
            return None
        
        # Rimuovi il prefisso "data:image/jpg;base64," se presente
        if img_data.startswith('data:'):
            img_data = img_data.split(',', 1)[1]
        
        # Decodifica da base64
        img_bytes = base64.b64decode(img_data)
        
        # Converti in numpy array
        nparr = np.frombuffer(img_bytes, np.uint8)
        
        # Decodifica come immagine OpenCV
        frame = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        
        return frame
    except Exception as e:
        print(f"Errore nel catturare screenshot da {source_name}: {e}")
        return None

# =========================
# CAMERA CAPTURE HELPER
# =========================

class CameraCapture:
    """Classe per gestire cattura da VideoCapture o OBS Screenshot"""
    def __init__(self, camera_index, obs_client, obs_source_name=None, mode="auto"):
        self.camera_index = camera_index
        self.obs_client = obs_client
        self.obs_source_name = obs_source_name
        self.mode = mode
        self.cap = None
        self.use_obs = False
        
        # Prova prima con VideoCapture se mode è "auto" o "videocapture"
        if mode in ["auto", "videocapture"]:
            self.cap = self._try_open_videocapture()
            if self.cap and self.cap.isOpened():
                self.use_obs = False
                print(f"Camera {camera_index}: Usando VideoCapture")
                return
        
        # Fallback a OBS screenshot se VideoCapture fallisce o mode è "obs_screenshot"
        if mode in ["auto", "obs_screenshot"]:
            if self._try_obs_screenshot():
                return
        
        raise RuntimeError(
            f"Impossibile aprire camera {camera_index}: "
            f"VideoCapture fallito e OBS Screenshot non disponibile"
        )
    
    def _try_obs_screenshot(self):
        """Prova a usare OBS Screenshot come metodo di cattura"""
        if not self.obs_source_name:
            self.obs_source_name = find_camera_source(self.obs_client, self.camera_index)
        
        if self.obs_source_name:
            # Verifica che lo screenshot funzioni davvero
            test_frame = capture_obs_screenshot(self.obs_client, self.obs_source_name)
            if test_frame is not None and np.mean(test_frame) > 1.0:
                self.use_obs = True
                if self.cap:
                    self.cap.release()
                    self.cap = None
                print(f"Camera {self.camera_index}: Usando OBS Screenshot (sorgente: {self.obs_source_name})")
                return True
            else:
                print(f"Camera {self.camera_index}: OBS Screenshot ha restituito frame vuoto/nero")
        else:
            print(f"Camera {self.camera_index}: Nessuna sorgente OBS trovata")
        return False
    
    def _is_frame_valid(self, frame):
        """Verifica che il frame non sia nero/vuoto (tipico quando OBS blocca la camera)"""
        if frame is None or frame.size == 0:
            return False
        # Un frame nero ha media ~0, un frame reale ha media >> 5
        return np.mean(frame) > 5.0
    
    def _try_open_videocapture(self):
        """Prova ad aprire la camera con diversi backend, verifica frame non nero"""
        # Prova prima Media Foundation (supporta accesso condiviso su Windows 10/11)
        print(f"Camera {self.camera_index}: Tentativo apertura con Media Foundation...")
        cap = cv2.VideoCapture(self.camera_index, cv2.CAP_MSMF)
        
        if cap.isOpened():
            try:
                ret, frame = cap.read()
                if ret and frame is not None:
                    test_frame = np.array(frame, copy=True, order='C')
                    if self._is_frame_valid(test_frame):
                        print(f"Camera {self.camera_index}: Media Foundation OK (frame valido)")
                        cap.release()
                        cap = cv2.VideoCapture(self.camera_index, cv2.CAP_MSMF)
                        return cap
                    else:
                        print(f"Camera {self.camera_index}: Media Foundation frame nero/vuoto")
            except Exception as e:
                print(f"Camera {self.camera_index}: Media Foundation errore ({e})")
            cap.release()
        
        # Fallback a DirectShow
        print(f"Camera {self.camera_index}: Tentativo con DirectShow...")
        cap = cv2.VideoCapture(self.camera_index, cv2.CAP_DSHOW)
        
        if cap.isOpened():
            try:
                ret, frame = cap.read()
                if ret and frame is not None:
                    if self._is_frame_valid(frame):
                        print(f"Camera {self.camera_index}: DirectShow OK (frame valido)")
                        cap.release()
                        cap = cv2.VideoCapture(self.camera_index, cv2.CAP_DSHOW)
                        return cap
                    else:
                        print(f"Camera {self.camera_index}: DirectShow frame nero/vuoto (camera occupata da OBS?)")
            except Exception as e:
                print(f"Camera {self.camera_index}: DirectShow errore ({e})")
            cap.release()
        
        print(f"Camera {self.camera_index}: VideoCapture non disponibile, provo OBS Screenshot...")
        return None
    
    def read(self):
        """Legge un frame dalla camera"""
        if self.use_obs:
            frame = capture_obs_screenshot(self.obs_client, self.obs_source_name)
            return (frame is not None), frame
        else:
            try:
                ok, frame = self.cap.read()
                if ok and frame is not None:
                    frame = np.array(frame, copy=True, order='C')
                return ok, frame
            except Exception as e:
                print(f"Errore durante lettura frame dalla camera {self.camera_index}: {e}")
                return False, None
    
    def release(self):
        """Rilascia le risorse"""
        if self.cap:
            self.cap.release()
    
    def set(self, prop, value):
        """Imposta proprietà (solo per VideoCapture)"""
        if self.cap and not self.use_obs:
            return self.cap.set(prop, value)
        return False

# =========================
# MAIN
# =========================

def main():
    print("Connessione a OBS...")
    ws = obsws(OBS_HOST, OBS_PORT, OBS_PASSWORD)
    ws.connect()
    print("Connesso a OBS.")

    # Apertura webcam con supporto fallback
    print("\nApertura camera A...")
    cap_a = CameraCapture(
        CAMERA_INDEX_A, 
        ws, 
        obs_source_name=OBS_SOURCE_A,
        mode=CAPTURE_MODE
    )
    
    time.sleep(0.5)  # Piccola pausa tra le aperture
    
    print("\nApertura camera B...")
    cap_b = CameraCapture(
        CAMERA_INDEX_B, 
        ws, 
        obs_source_name=OBS_SOURCE_B,
        mode=CAPTURE_MODE
    )
    
    print("\n" + "="*50)

    # Facoltativo: forza risoluzione (solo per VideoCapture)
    for cap in (cap_a, cap_b):
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
        cap.set(cv2.CAP_PROP_FPS, 30)

    current_scene = get_obs_scene(ws)
    if current_scene not in (SCENE_A, SCENE_B):
        current_scene = SCENE_A
        set_obs_scene(ws, current_scene)
        print(f"Scena iniziale impostata a {current_scene}")

    smoothed_a = None
    smoothed_b = None
    last_switch_time = 0.0
    no_face_since = None

    candidate_scene = None
    candidate_since = None

    # Create face detector with new API
    base_options = tasks.BaseOptions(model_asset_path=MODEL_PATH)
    options = tasks.vision.FaceDetectorOptions(
        base_options=base_options,
        min_detection_confidence=0.5
    )
    detector = tasks.vision.FaceDetector.create_from_options(options)

    print("Loop avviato. Premi CTRL+C per uscire.")

    try:
        while True:
            ok_a, frame_a = cap_a.read()
            ok_b, frame_b = cap_b.read()

            if not ok_a or frame_a is None:
                print("⚠ Frame non valido da Camera A")
                time.sleep(0.2)
                continue

            if not ok_b or frame_b is None:
                print("⚠ Frame non valido da Camera B")
                time.sleep(0.2)
                continue

            res_a = analyze_frame(frame_a, detector)
            res_b = analyze_frame(frame_b, detector)

            score_a = res_a["score"]
            score_b = res_b["score"]

            smoothed_a = smooth_score(smoothed_a, score_a)
            smoothed_b = smooth_score(smoothed_b, score_b)

            face_a = res_a["face_found"]
            face_b = res_b["face_found"]

            now = time.time()

            # Gestione no-face
            if not face_a and not face_b:
                if no_face_since is None:
                    no_face_since = now
                elif now - no_face_since > NO_FACE_HOLD_SECONDS:
                    # Teniamo la scena corrente, senza switch
                    pass

                print(
                    f"[NO FACE] scene={current_scene} | "
                    f"A={smoothed_a:.3f} B={smoothed_b:.3f}"
                )
                time.sleep(LOOP_SLEEP)
                continue
            else:
                no_face_since = None

            # Decisione grezza
            desired_scene = current_scene

            if face_a and not face_b:
                desired_scene = SCENE_A
            elif face_b and not face_a:
                desired_scene = SCENE_B
            else:
                # entrambi vedono il volto
                if current_scene == SCENE_A:
                    if smoothed_b > smoothed_a + SWITCH_THRESHOLD:
                        desired_scene = SCENE_B
                elif current_scene == SCENE_B:
                    if smoothed_a > smoothed_b + SWITCH_THRESHOLD:
                        desired_scene = SCENE_A
                else:
                    desired_scene = SCENE_A if smoothed_a >= smoothed_b else SCENE_B

            ### OVVERRIDE
            #print(f" score_b -> { score_b}")
            #if score_b > 0.380:
            #    desired_scene = SCENE_B
            #else:
            #    desired_scene = SCENE_A

            # Persistenza + cooldown
            if desired_scene != current_scene:
                if candidate_scene != desired_scene:
                    candidate_scene = desired_scene
                    candidate_since = now
                else:
                    enough_persistence = (now - candidate_since) >= SWITCH_PERSISTENCE
                    enough_cooldown = (now - last_switch_time) >= SWITCH_COOLDOWN

                    if enough_persistence and enough_cooldown:
                        set_obs_scene(ws, desired_scene)
                        current_scene = desired_scene
                        last_switch_time = now
                        candidate_scene = None
                        candidate_since = None
                        print(f"🔄 SWITCH -> {current_scene}")
            else:
                candidate_scene = None
                candidate_since = None

            debug_a = res_a["debug"]
            debug_b = res_b["debug"]

            print(
                f"[{current_scene}] "
                f"A(face={face_a}, score={smoothed_a:.3f}, area={debug_a['face_area_norm']:.3f}, center={debug_a['center_score']:.3f}, conf={debug_a['confidence']:.3f}) | "
                f"B(face={face_b}, score={smoothed_b:.3f}, area={debug_b['face_area_norm']:.3f}, center={debug_b['center_score']:.3f}, conf={debug_b['confidence']:.3f})"
            )

            time.sleep(LOOP_SLEEP)
    finally:
        detector.close()
        cap_a.release()
        cap_b.release()
        ws.disconnect()

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrotto dall'utente.")
    except Exception as e:
        print(f"Errore: {e}")